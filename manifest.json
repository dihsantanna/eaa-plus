{
  "manifest_version": 3,
  "name": "EAA+ — Melhorias para alunos",
  "version": "1.1.0",
  "description": "Melhorias para alunos da EAA/FABAT: filtro e próxima aula nas aulas síncronas e progresso das avaliações no AVA.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://escoladeadoracaoearte.com.br/aulas-sincronas-graduacao-ead/*"
      ],
      "js": [
        "src/core.js",
        "src/features/period-filter.js",
        "src/features/next-class.js"
      ],
      "css": [
        "src/features/period-filter.css",
        "src/features/next-class.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://batistas.brightspace.com/d2l/*"
      ],
      "js": [
        "src/core.js",
        "src/ava-rules.js",
        "src/ava-network.js",
        "src/ava-cache.js",
        "src/ava-data.js",
        "src/features/ava-progress.js",
        "src/features/ava-course.js"
      ],
      "run_at": "document_idle",
      "css": [
        "src/ava-theme.css",
        "src/features/ava-progress.css",
        "src/features/ava-course.css"
      ]
    }
  ]
}
