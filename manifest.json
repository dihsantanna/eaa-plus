{
  "manifest_version": 3,
  "name": "EAA+ — Melhorias para alunos",
  "version": "1.1.0",
  "description": "Melhorias para alunos da EAA/FABAT: filtro e próxima aula nas aulas síncronas e progresso das avaliações no AVA.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/fundo.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://escoladeadoracaoearte.com.br/aulas-sincronas-graduacao-ead/*"
      ],
      "js": [
        "src/core.js",
        "src/features/filtro-periodos.js",
        "src/features/proxima-aula.js"
      ],
      "css": [
        "src/features/filtro-periodos.css",
        "src/features/proxima-aula.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://batistas.brightspace.com/d2l/*"
      ],
      "js": [
        "src/core.js",
        "src/ava-dados.js",
        "src/features/ava-progresso.js",
        "src/features/ava-disciplina.js"
      ],
      "run_at": "document_idle",
      "css": [
        "src/features/ava-progresso.css",
        "src/features/ava-disciplina.css"
      ]
    }
  ]
}
