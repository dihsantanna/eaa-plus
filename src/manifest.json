{
  "manifest_version": 3,
  "name": "EAA+ — Melhorias para alunos",
  "version": "1.0.0",
  "description": "Progresso das avaliações no AVA da EAA/FABAT: o que já foi corrigido, o que aguarda correção, o que falta e os prazos.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://batistas.brightspace.com/d2l/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
